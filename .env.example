# Voice Clone Evaluator Configuration
# ---------------------------------------------
# Minimum composite similarity score to pass quality gate (0.0 - 100.0)
SIMILARITY_THRESHOLD=80.0

# Expected standard sample rate in Hz
DEFAULT_SAMPLE_RATE=44100

# Enable verbose acoustic telemetry in console output (true/false)
VERBOSE_OUTPUT=false

# Default export path for evaluation metrics
METRICS_EXPORT_PATH=metrics_summary.json
